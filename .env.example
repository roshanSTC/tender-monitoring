# ==============================================================================
# Tender Monitoring System - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tender_monitoring
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# In production, generate a secure random key (e.g. `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=spmcil-tender-monitoring-default-secret-change-in-production

# ------------------------------------------------------------------------------
# Web & Frontend CORS Configuration
# Comma-separated list of allowed frontend origins
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Email & SMTP Alert Configuration
# ------------------------------------------------------------------------------
EMAIL_SENDER=your-smtp-email@gmail.com
EMAIL_PASSWORD=your-smtp-app-password
EMAIL_RECEIVER=admin@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
MAIL_FROM=Tender Alert System <your-smtp-email@gmail.com>

# ------------------------------------------------------------------------------
# Background Scheduler Configuration
# ------------------------------------------------------------------------------
SCRAPE_INTERVAL_HOURS=6
RUN_ON_STARTUP=true

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------
GOOGLE_SHEET_NAME=SPMCIL_Tenders
